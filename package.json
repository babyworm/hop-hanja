{
  "name": "hop",
  "version": "0.5.4",
  "private": true,
  "description": "HOP is Open HWP",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build:studio": "pnpm --filter @golbin/hop-studio-host build",
    "build:quicklook:macos": "node scripts/build-quicklook-macos.mjs",
    "build:before-tauri": "pnpm run build:studio && pnpm run build:quicklook:macos",
    "build:desktop": "pnpm --filter hop-desktop build",
    "dictionary:build": "node scripts/build-hanja-database.mjs && node scripts/verify-hanja-database.mjs",
    "dictionary:extract:stdict": "node scripts/extract-stdict-hanja-supplement.mjs",
    "dictionary:verify": "node scripts/verify-hanja-database.mjs",
    "hop-fork:verify": "node scripts/verify-hop-fork-private-inputs.mjs",
    "hop-fork:rebaseline": "node scripts/verify-hop-fork-private-inputs.mjs --rebaseline",
    "prebuild:studio": "pnpm run dictionary:verify",
    "postupstream:verify": "pnpm run hop-fork:verify",
    "posttest:upstream": "pnpm run test:fork",
    "test:dictionary": "node --test tests/hanja-database.test.mjs",
    "test:fork": "pnpm run test:dictionary && node --test tests/hop-fork.test.mjs",
    "tauri": "pnpm --filter hop-desktop tauri",
    "test": "pnpm run test:upstream && pnpm run test:studio && pnpm run test:desktop && pnpm run test:quicklook:macos && pnpm run test:appimage:linux",
    "test:upstream": "node --test tests/update-upstream.test.mjs tests/rhwp-baseline.test.mjs tests/rhwp-boundary.test.mjs tests/hop-version.test.mjs tests/rhwp-wasm.test.mjs",
    "test:studio": "pnpm --filter @golbin/hop-studio-host test",
    "test:desktop": "cd apps/desktop/src-tauri && cargo test",
    "test:quicklook:macos": "node scripts/test-quicklook-macos.mjs",
    "clippy:desktop": "cd apps/desktop/src-tauri && cargo clippy -- -D warnings",
    "upstream:update": "node scripts/update-rhwp-upstream.mjs",
    "upstream:verify": "node scripts/verify-rhwp-upstream.mjs",
    "test:appimage:linux": "node --test tests/linux-appimage.test.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "smol-toml": "^1.9.1"
  }
}
